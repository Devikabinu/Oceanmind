# ------------------------------------------------------------------
# Ocean Environmental Intelligence Platform - Module 1
# Copy this file to .env and fill in real values before running.
# ------------------------------------------------------------------

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=ocean_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ocean_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy URL (used directly by the backend)
DATABASE_URL=postgresql+psycopg2://ocean_admin:change_me_locally@db:5432/ocean_platform

# --- Auth / JWT ---
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- NOAA OISST v2.1 ---
# Public dataset served over HTTPS/OPeNDAP by NOAA PSL. No API key required.
# https://psl.noaa.gov/data/gridded/data.noaa.oisst.v2.highres.html
NOAA_OISST_BASE_URL=https://psl.noaa.gov/thredds/dodsC/Datasets/noaa.oisst.v2.highres

# --- OBIS ---
# Public REST API, no key required.
# https://api.obis.org
OBIS_API_BASE_URL=https://api.obis.org/v3

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Optional AI interpretation of the physical drivers (off by default) ---
# The physical explanation always works without it: a deterministic, evidence-based narrator writes it from the measurements. Setting a provider lets a language model write the
# wording from the same evidence; its output is checked against the evidence (no invented numbers, no causal claims) and falls back to the narrator when it fails the check.
# The key is used by the backend only. Example:
#   AI_PROVIDER=anthropic
#   AI_API_KEY=your-key
#   AI_MODEL=your-model-name
# or, for a local OpenAI-compatible server:
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=http://localhost:8080/v1
#   AI_MODEL=your-local-model
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_S=25
