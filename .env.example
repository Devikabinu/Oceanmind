# ------------------------------------------------------------------
# Ocean Environmental Intelligence Platform - Module 1
# Copy this file to .env and fill in real values before running.
# ------------------------------------------------------------------

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=ocean_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ocean_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy URL (used directly by the backend)
DATABASE_URL=postgresql+psycopg2://ocean_admin:change_me_locally@db:5432/ocean_platform

# --- Auth / JWT ---
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- NOAA OISST v2.1 ---
# Public dataset served over HTTPS/OPeNDAP by NOAA PSL. No API key required.
# https://psl.noaa.gov/data/gridded/data.noaa.oisst.v2.highres.html
NOAA_OISST_BASE_URL=https://psl.noaa.gov/thredds/dodsC/Datasets/noaa.oisst.v2.highres

# --- Copernicus Marine Service ---
# Requires a free account at https://data.marine.copernicus.eu/register
# Used by the `copernicusmarine` Python toolbox to authenticate.
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
# Product SST_GLO_PHY_L4_NRT_010_005 - "Global Ocean GMPE Sea Surface
# Temperature Multi Product Ensemble" (Met Office, GHRSST). Verified via
# `copernicusmarine describe --contains GMPE` against the live public catalog.
COPERNICUS_MARINE_DATASET_ID=cmems_obs-sst_glo_phy-temp_nrt_P1D-m

# --- OBIS ---
# Public REST API, no key required.
# https://api.obis.org
OBIS_API_BASE_URL=https://api.obis.org/v3

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
